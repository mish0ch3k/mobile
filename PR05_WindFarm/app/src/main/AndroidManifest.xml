<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Локальні сповіщення (Android 13+ — дозвіл під час виконання) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Частота опитування сенсорів вище 200 Гц не використовується, HIGH_SAMPLING_RATE_SENSORS не потрібен -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_wind_turbine"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WindFarm">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Дії «Підтвердити» / «Відкласти» зі шторки сповіщень -->
        <receiver android:name=".notify.AlertActionReceiver" android:exported="false" />
    </application>
</manifest>
